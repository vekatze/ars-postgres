{
  target {
    test {
      main "_test.nt",
      build-option [
        // (AddressSanitizer might report memory leaks in libpq on macOS)
        "-fsanitize=address",
      ],
    },
  },
  foreign {
    input [
      "source/foreign.c",
    ],
    output [
      "foreign.o",
    ],
    link [
      "foreign.o",
    ],
    transitive-link-option [
      "$(pkg-config libpq --libs)",
    ],
    script [
      "{{clang}} $(pkg-config libpq --cflags) -c -flto=thin -O2 source/foreign.c -o {{foreign}}/foreign.o",
    ],
  },
  static-file {
    reset "source/sql/reset.sql",
    insert-author "source/sql/author/insert.sql",
    select-author "source/sql/author/select.sql",
  },
  dependency {
    core {
      digest "y_tXrgTua-N3029uEirZRTdGbOVWnwcO8IjX7QqiW1U",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.9.tar.zst",
      ],
      enable-preset true,
    },
  },
}
